<!-- pages/study/study.wxml -->
<view class="page">

  <!-- 顶部导航 -->
  <view class="nav">
    <view class="nav-back" bindtap="goBack">← 返回</view>
  </view>

  <!-- 进度条 -->
  <view class="progress-wrap">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <view class="progress-text">已记住 {{knownCount}} / {{total}}</view>
  </view>

  <!-- 统计（2格） -->
  <view class="stats-row">
    <view class="stat">
      <view class="stat-num">{{deckCount}}</view>
      <view class="stat-label">剩余</view>
    </view>
    <view class="stat">
      <view class="stat-num" style="color:#3aaa7a">{{knownCount}}</view>
      <view class="stat-label">已记住</view>
    </view>
  </view>

  <!-- 牌堆 + 发音按钮 -->
  <view class="deck-area">
    <view class="card-row">

      <view class="card-wrap">
        <view
          wx:for="{{stackLayers}}"
          wx:key="i"
          class="stack-shadow"
          style="top:{{(stackLayers.length-item.i)*6}}rpx; left:{{(stackLayers.length-item.i)*4}}rpx; z-index:{{item.i}};"
        ></view>

        <!-- 主卡片：支持翻牌 -->
        <view class="card {{flipped ? 'card-flipped' : ''}} {{cardExiting ? 'card-exit' : ''}}">

          <!-- 正面 -->
          <view class="card-face front">
            <view wx:if="{{errorCount > 0}}" class="error-badge">{{errorCount}}</view>
            <view class="kana-big">{{frontChar}}</view>
          </view>

          <!-- 背面：答案 + 发音 -->
          <view class="card-face back">
            <view class="kana-answer">{{backChar}}</view>
            <view wx:if="{{backRoma}}" class="roma-text">{{backRoma}}</view>
          </view>

        </view>
      </view>

      <!-- 发音按钮（牌右侧） -->
      <view class="audio-side" catchtap="playAudio">
        <view class="audio-icon-wrap">
          <view class="audio-icon">♪</view>
        </view>
        <view class="audio-label">发音</view>
      </view>

    </view>
  </view>

  <!-- 操作按钮区 -->
  <view class="action-area">

    <!-- 翻牌前：两个主按钮 -->
    <view wx:if="{{!flipped}}" class="btn-row">
      <view class="btn btn-retry {{animating ? 'btn-disabled' : ''}}" bindtap="markRetry">
        <view class="btn-icon">↩</view>
        <view class="btn-text">这个假名我忘记了</view>
        <view class="btn-sub">翻开查看读音</view>
      </view>
      <view class="btn btn-know {{animating ? 'btn-disabled' : ''}}" bindtap="markKnow">
        <view class="btn-icon">✓</view>
        <view class="btn-text">这个假名我已经认识</view>
        <view class="btn-sub">放到旁边</view>
      </view>
    </view>

    <!-- 翻牌后：置于牌底 -->
    <view wx:else class="btn-bottom {{animating ? 'btn-disabled' : ''}}" bindtap="markBottom">
      <view class="btn-bottom-icon">↓</view>
      <view class="btn-bottom-text">将其置于牌底</view>
    </view>

  </view>

</view>
