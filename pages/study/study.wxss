/* pages/study/study.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* ---- nav ---- */
.nav {
  display: flex;
  align-items: center;
  padding: 100rpx 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: rgba(240,237,232,0.45);
  padding: 8rpx 0;
}
.nav-back:active { opacity: 0.6; }

/* ---- progress ---- */
.progress-wrap { margin-bottom: 36rpx; }

.progress-bar {
  height: 6rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}
.progress-fill {
  height: 100%;
  background: #3aaa7a;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}
.progress-text {
  font-size: 22rpx;
  color: rgba(240,237,232,0.3);
  text-align: right;
}

/* ---- stats ---- */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 48rpx;
}
.stat {
  flex: 1;
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 500;
  color: #f0ede8;
  line-height: 1.1;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(240,237,232,0.35);
}

/* ---- deck area ---- */
.deck-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
}

.card-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* ---- card ---- */
.card-wrap {
  position: relative;
  width: 480rpx;
  height: 440rpx;
  flex-shrink: 0;
}

.stack-shadow {
  position: absolute;
  width: 480rpx;
  height: 440rpx;
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 28rpx;
}

.card {
  position: absolute;
  top: 0; left: 0;
  width: 480rpx;
  height: 440rpx;
  background: #1e1e20;
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 28rpx;
  z-index: 10;
  transform-style: preserve-3d;
  transition: transform 0.4s ease, opacity 0.28s ease;
}

/* 翻牌 */
.card-flipped { transform: rotateY(180deg); }

/* 退场淡出 */
.card-exit { opacity: 0.12; transform: scale(0.92); }
.card-flipped.card-exit { opacity: 0.12; transform: rotateY(180deg) scale(0.92); }

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.back { transform: rotateY(180deg); }

/* ── 正面 ── */
.kana-big {
  font-size: 140rpx;
  line-height: 1;
  color: #f0ede8;
  letter-spacing: 12rpx;
}

/* 错误次数徽章（右上角红圈）*/
.error-badge {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  min-width: 56rpx;
  height: 56rpx;
  background: #e8543a;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  padding: 0 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(232,84,58,0.45);
}

/* ── 背面 ── */
.kana-answer {
  font-size: 96rpx;
  line-height: 1;
  color: #c9a84c;
  margin-bottom: 16rpx;
}
.roma-text {
  font-size: 40rpx;
  color: rgba(240,237,232,0.4);
  letter-spacing: 4rpx;
  font-weight: 300;
}

/* ---- 发音按钮（牌右侧）---- */
.audio-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.audio-side:active .audio-icon-wrap { opacity: 0.65; transform: scale(0.93); }

.audio-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: rgba(201,168,76,0.12);
  border: 1rpx solid rgba(201,168,76,0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.audio-icon { font-size: 36rpx; color: #c9a84c; line-height: 1; }
.audio-label { font-size: 20rpx; color: rgba(240,237,232,0.3); letter-spacing: 1rpx; }

/* ---- 操作按钮 ---- */
.action-area { margin-top: 48rpx; }

.btn-row { display: flex; gap: 20rpx; }

.btn {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.btn:active { opacity: 0.75; transform: scale(0.97); }

.btn-disabled { opacity: 0.3; pointer-events: none; }

.btn-retry {
  background: rgba(232,84,58,0.1);
  border: 1rpx solid rgba(232,84,58,0.3);
}
.btn-know {
  background: rgba(58,170,122,0.1);
  border: 1rpx solid rgba(58,170,122,0.3);
}

.btn-icon { font-size: 36rpx; line-height: 1; }
.btn-retry .btn-icon { color: #e8543a; }
.btn-know  .btn-icon { color: #3aaa7a; }

.btn-text {
  font-size: 25rpx;
  font-weight: 500;
  color: #f0ede8;
  text-align: center;
}
.btn-sub {
  font-size: 20rpx;
  color: rgba(240,237,232,0.35);
}

/* ── 翻牌后：将其置于牌底 ── */
.btn-bottom {
  width: 100%;
  height: 104rpx;
  background: rgba(201,168,76,0.1);
  border: 1rpx solid rgba(201,168,76,0.35);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.btn-bottom:active { opacity: 0.75; transform: scale(0.98); }

.btn-bottom-icon {
  font-size: 40rpx;
  color: #c9a84c;
  font-weight: 700;
  line-height: 1;
}
.btn-bottom-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #c9a84c;
  letter-spacing: 2rpx;
}
