<!-- pages/complete/complete.wxml -->
<view class="page">

  <!-- Hero -->
  <view class="hero">
    <view class="big-check">✓</view>
    <view class="hero-title">全部学完了！</view>
    <view class="hero-sub">{{total}} 张假名  ·  {{dateStr}}</view>
  </view>

  <!-- 一次认识率 -->
  <view class="rate-block">
    <view class="rate-num {{firstTryPct >= 80 ? 'rate-green' : firstTryPct >= 50 ? 'rate-gold' : 'rate-red'}}">
      {{firstTryPct}}%
    </view>
    <view class="rate-label">一次认识率</view>
  </view>

  <!-- 两格统计 -->
  <view class="stat-row">
    <view class="stat-box stat-green">
      <view class="sbox-num">{{firstTryCount}}</view>
      <view class="sbox-label">一次认识</view>
    </view>
    <view class="stat-box stat-red">
      <view class="sbox-num">{{retryCount}}</view>
      <view class="sbox-label">需要复习</view>
    </view>
  </view>

  <!-- 错误次数分布 -->
  <view wx:if="{{distribution.length > 0}}" class="section">
    <view class="section-title">错误次数分布</view>
    <view wx:for="{{distribution}}" wx:key="errors" class="dist-row">
      <view class="dist-lbl">{{item.errors}}次</view>
      <view class="dist-track">
        <view class="dist-fill" style="width:{{item.pct}}%"></view>
      </view>
      <view class="dist-cnt">{{item.count}}张</view>
    </view>
  </view>

  <!-- 重点复习（最难的几张） -->
  <view wx:if="{{hardest.length > 0}}" class="section">
    <view class="section-title">重点复习</view>
    <view class="hard-list">
      <view wx:for="{{hardest}}" wx:key="roma" class="hard-item">
        <view class="hard-kana">{{item.kana}}</view>
        <view class="hard-roma">{{item.roma}}</view>
        <view class="hard-badge">✗ {{item.errors}}</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">

    <!-- 分享给朋友（open-type="share" 触发 onShareAppMessage） -->
    <button class="btn-share" open-type="share">
      <view class="share-icon">↗</view>
      <view class="share-text">分享学习报告</view>
    </button>

    <!-- 下载到相册 -->
    <view class="btn-download {{saving ? 'btn-saving' : ''}}" bindtap="saveReport">
      <view class="dl-icon">↓</view>
      <view class="dl-text">{{saving ? '生成中...' : '保存到相册'}}</view>
    </view>

    <view class="btn-row-2">
      <view class="btn-secondary" bindtap="restart">再来一遍</view>
      <view class="btn-secondary" bindtap="goHome">回首页</view>
    </view>

  </view>

  <!-- 隐藏画布：用于生成报告图片 -->
  <canvas type="2d" id="reportCanvas" class="hidden-canvas"></canvas>

</view>
