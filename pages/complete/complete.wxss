/* pages/complete/complete.wxss */

.page {
  min-height: 100vh;
  padding: 0 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.confetti-area {
  margin-bottom: 48rpx;
}

.big-check {
  font-size: 160rpx;
  line-height: 1;
  color: #3aaa7a;
}

.result-block {
  text-align: center;
  margin-bottom: 60rpx;
}

.result-title {
  font-size: 56rpx;
  font-weight: 500;
  color: #f0ede8;
  margin-bottom: 16rpx;
}

.result-sub {
  font-size: 28rpx;
  color: rgba(240,237,232,0.45);
}

.divider {
  width: 80rpx;
  height: 1rpx;
  background: rgba(255,255,255,0.1);
  margin-bottom: 60rpx;
}

.remind-box {
  width: 100%;
  background: rgba(201,168,76,0.07);
  border: 1rpx solid rgba(201,168,76,0.25);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
}

.remind-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #c9a84c;
  margin-bottom: 16rpx;
}

.remind-text {
  font-size: 27rpx;
  color: rgba(240,237,232,0.55);
  line-height: 1.9;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  height: 100rpx;
  background: #c9a84c;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #0e0e0f;
}
.btn-primary:active { opacity: 0.8; }

.btn-secondary {
  height: 100rpx;
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: rgba(240,237,232,0.5);
}
.btn-secondary:active { opacity: 0.7; }
