/* pages/complete/complete.wxss */

.page {
  min-height: 100vh;
  padding: 60rpx 36rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

/* ---- Hero ---- */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.big-check {
  font-size: 120rpx;
  line-height: 1;
  color: #3aaa7a;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 500;
  color: #f0ede8;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(240,237,232,0.35);
}

/* ---- 认识率 ---- */
.rate-block {
  text-align: center;
  margin: 36rpx 0 28rpx;
}

.rate-num {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 8rpx;
}
.rate-green { color: #3aaa7a; }
.rate-gold  { color: #c9a84c; }
.rate-red   { color: #e8543a; }

.rate-label {
  font-size: 26rpx;
  color: rgba(240,237,232,0.35);
}

/* ---- 两格统计 ---- */
.stat-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-box {
  flex: 1;
  border-radius: 18rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}

.stat-green {
  background: rgba(58,170,122,0.08);
  border: 1rpx solid rgba(58,170,122,0.25);
}

.stat-red {
  background: rgba(232,84,58,0.08);
  border: 1rpx solid rgba(232,84,58,0.25);
}

.sbox-num {
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1.1;
  margin-bottom: 8rpx;
}
.stat-green .sbox-num { color: #3aaa7a; }
.stat-red   .sbox-num { color: #e8543a; }

.sbox-label {
  font-size: 22rpx;
  color: rgba(240,237,232,0.35);
}

/* ---- section ---- */
.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 24rpx;
  color: rgba(240,237,232,0.3);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

/* ---- 分布条 ---- */
.dist-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dist-lbl {
  width: 60rpx;
  font-size: 22rpx;
  color: rgba(240,237,232,0.4);
  text-align: right;
  flex-shrink: 0;
}

.dist-track {
  flex: 1;
  height: 20rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 10rpx;
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(232,84,58,0.5), rgba(232,84,58,0.85));
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.dist-cnt {
  width: 60rpx;
  font-size: 22rpx;
  color: rgba(240,237,232,0.4);
  text-align: left;
  flex-shrink: 0;
}

/* ---- 重点复习列表 ---- */
.hard-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hard-item {
  display: flex;
  align-items: center;
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.hard-kana {
  font-size: 52rpx;
  color: #f0ede8;
  width: 80rpx;
  line-height: 1;
}

.hard-roma {
  flex: 1;
  font-size: 26rpx;
  color: rgba(240,237,232,0.4);
  padding-left: 20rpx;
}

.hard-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #e8543a;
  background: rgba(232,84,58,0.1);
  border: 1rpx solid rgba(232,84,58,0.3);
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
}

/* ---- 操作按钮 ---- */
.actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── 分享按钮（微信 button open-type="share"）── */
.btn-share {
  width: 100%;
  height: 104rpx;
  background: #3aaa7a;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 104rpx;
}
.btn-share::after { border: none; }
.btn-share:active { opacity: 0.8; transform: scale(0.98); }

.share-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}
.share-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.btn-download {
  height: 104rpx;
  background: #c9a84c;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-download:active { opacity: 0.8; transform: scale(0.98); }

.btn-saving {
  opacity: 0.6;
  pointer-events: none;
}

.dl-icon {
  font-size: 36rpx;
  color: #0e0e0f;
  font-weight: 700;
}

.dl-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #0e0e0f;
}

.btn-row-2 {
  display: flex;
  gap: 16rpx;
}

.btn-secondary {
  flex: 1;
  height: 96rpx;
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(240,237,232,0.5);
}
.btn-secondary:active { opacity: 0.7; }

/* ---- 隐藏画布（屏幕外渲染）---- */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 600rpx;
  height: 900rpx;
}
