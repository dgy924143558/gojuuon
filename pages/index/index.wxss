/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  display: flex;
  flex-direction: column;
}

/* ---- hero ---- */
.hero {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.badge {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #c9a84c;
  border: 1rpx solid rgba(201,168,76,0.4);
  border-radius: 40rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 36rpx;
}

.title-jp {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  line-height: 1.1;
  color: #f0ede8;
  margin-bottom: 8rpx;
}

.title-zh {
  font-size: 28rpx;
  color: rgba(240,237,232,0.45);
  letter-spacing: 6rpx;
  margin-bottom: 32rpx;
  font-weight: 300;
}

.desc {
  font-size: 26rpx;
  color: rgba(240,237,232,0.5);
  line-height: 1.9;
}

/* ---- mode ---- */
.section-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(240,237,232,0.35);
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.mode-card {
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  position: relative;
  transition: all 0.2s;
}

.mode-card.active {
  border-color: rgba(201,168,76,0.5);
  background: rgba(201,168,76,0.06);
}

.mode-label-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 220rpx;
}

.mode-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #f0ede8;
}

/* 推荐徽章 */
.mode-hot {
  font-size: 18rpx;
  font-weight: 600;
  color: #0e0e0f;
  background: #c9a84c;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  letter-spacing: 1rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: rgba(240,237,232,0.45);
  flex: 1;
}

.mode-check {
  font-size: 28rpx;
  color: #c9a84c;
  font-weight: 700;
  width: 40rpx;
  text-align: right;
}

/* ---- card count ---- */
.card-count {
  text-align: center;
  font-size: 24rpx;
  color: rgba(240,237,232,0.3);
  margin-bottom: 48rpx;
}

/* ---- start btn ---- */
.start-btn {
  background: #c9a84c;
  border-radius: 20rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #0e0e0f;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
}

.start-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.arrow {
  font-size: 36rpx;
}

/* ---- tip ---- */
.tip-box {
  background: #1a1a1c;
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
}

.tip-title {
  font-size: 26rpx;
  color: rgba(240,237,232,0.6);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.tip-text {
  font-size: 25rpx;
  color: rgba(240,237,232,0.4);
  line-height: 1.9;
}
