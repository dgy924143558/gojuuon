/* 全局样式 */
page {
  background-color: #0e0e0f;
  color: #f0ede8;
  font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-weight: 300;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  transition: opacity 0.15s;
}

.btn:active {
  opacity: 0.7;
}
